extends layout

block content
  h1 Reviews for #{productName} (ID: #{productId})

  if avgRating !== null
    p
      b Average rating:
      |  #{avgRating.toFixed(2)} / 10
  else
    p
      b Average rating:
      |  N/A (no reviews)

  if reviews.length === 0
    p No reviews yet.
  else
    ul
      each r in reviews
        li #{r.rating} / 10

  p
    a(href=`/products/${productId}`) Back to Product
