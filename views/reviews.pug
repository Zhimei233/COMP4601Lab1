extends layout

block content
  h1 Reviews for #{productName} (ID: #{productId})

  if avgRating !== null
    p
      b Average rating:
      |  #{avgRating.toFixed(2)} / 10
  else
    p
      b Average rating:
      |  N/A (no reviews)

  if reviews.length === 0
    p No reviews yet.
  else
    ul
      each r in reviews
        li #{r.rating} / 10

  .panel
    .section-title Add a review (rating 1–10)
    p.small Sends JSON: { "rating": 1..10 }

    label(for="ratingInput") Rating
    input#ratingInput(type="text" placeholder="e.g., 8")

    button(type="button" onclick="addReview()") Add Review
    pre#msg

  p
    a(href=`/products/${productId}`) Back to Product

  script.
    async function addReview(){
      const ratingStr = document.getElementById('ratingInput').value.trim();
      const rating = Number(ratingStr);
      const msg = document.getElementById('msg');
      msg.textContent = '';

      const res = await fetch(`/products/${#{productId}}/reviews`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ rating })
      });

      let text;
      try {
        const data = await res.json();
        text = JSON.stringify(data, null, 2);
      } catch (e) {
        text = await res.text();
      }

      msg.textContent = `Status: ${res.status}\n` + text;

      if (res.ok) {
        window.location.reload();
      }
    }
