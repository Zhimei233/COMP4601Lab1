extends layout

block content
  h1 Welcome to the e-commerce Home Page!

  .panel
    .section-title Search products (JSON)
    label(for="s_name") Name
    input#s_name(type="text" placeholder="e.g., bike")

    label
      input#s_inStock(type="checkbox")
      |  In stock only

    button(type="button" onclick="search()") Search
    pre#out

  .panel
    .section-title Create product (JSON)
    p.small Sends JSON: { name, price, x, y, z, stock }
    label Name
    input#c_name(type="text" placeholder="e.g., Wireless Mouse")
    label Price
    input#c_price(type="number" step="0.01" placeholder="19.99")
    label Dimensions (x, y, z)
    div.dimRow
    input#c_x(type="text" placeholder="x")
    input#c_y(type="text" placeholder="y")
    input#c_z(type="text" placeholder="z")
    label Stock
    input#c_stock(type="number" step="1" placeholder="25")
    button(type="button" onclick="createProduct()") Create
    pre#createOut

  .panel
    .section-title Jump to product pages
    label Product ID
    input#pid(type="text" placeholder="e.g., 0")
    button(type="button" onclick="goDetail()") Go to Detail (HTML)
    button(type="button" onclick="goReviews()") Go to Reviews (HTML)

  script.
    const chkIn = document.getElementById('s_inStock');
    const chkAll = document.getElementById('s_all');
    chkIn.addEventListener('change', () => { if (chkIn.checked) chkAll.checked = false; });
    chkAll.addEventListener('change', () => { if (chkAll.checked) chkIn.checked = false; });

    function setPid(id){ document.getElementById('pid').value = id; }

    async function loadFeatured(){
      const ul = document.getElementById('featured');
      ul.innerHTML = '<li>Loading...</li>';
      const res = await fetch('/products?all=true', { headers: { "Accept": "application/json" } });
      const data = await res.json();

      ul.innerHTML = '';
      if (!Array.isArray(data) || data.length === 0){
        ul.innerHTML = '<li>No products.</li>';
        return;
      }
      // show first two
      const take = data.slice(0, 2);
      for(const p of take){
        const li = document.createElement('li');
        li.innerHTML = `<b>${p.name}</b> for only $${p.price} (<a href="/products/${p.id}">view</a>)`;
        ul.appendChild(li);
      }
      setPid(take[0].id);
    }
    loadFeatured();

    // Product search
    async function search(){
      const name = encodeURIComponent(document.getElementById('s_name').value.trim());

      let url = `/products?name=${name}`;

      if (chkIn.checked) {
        url += `&inStock=true`;
      }

      const res = await fetch(url, {
        headers: { "Accept": "application/json" }
      });

      const data = await res.json();
      document.getElementById('out').textContent =
        JSON.stringify(data, null, 2);

      if (Array.isArray(data) && data.length > 0) {
        setPid(data[0].id);
      }
    }

    // Create product
    async function createProduct(){
      const out = document.getElementById('createOut');
      out.textContent = '';
      const body = {
        name: document.getElementById('c_name').value.trim(),
        price: Number(document.getElementById('c_price').value),
        x: Number(document.getElementById('c_x').value),
        y: Number(document.getElementById('c_y').value),
        z: Number(document.getElementById('c_z').value),
        stock: Number(document.getElementById('c_stock').value)
      };
      const res = await fetch('/products', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', "Accept": "application/json" },
        body: JSON.stringify(body)
      });
      let text;
      try{
        const data = await res.json();
        text = JSON.stringify(data, null, 2);
        if (data && data.id !== undefined) setPid(data.id);
      }catch{
        text = await res.text();
      }
      out.textContent = `Status: ${res.status}\n` + text;
    }

    function goDetail(){
      const id = document.getElementById('pid').value.trim();
      window.location.href = `/products/${id}`;
    }
    function goReviews(){
      const id = document.getElementById('pid').value.trim();
      window.location.href = `/products/${id}/reviews`;
    }
